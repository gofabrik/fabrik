package shared

import (
	"bytes"
	"net/http"
	"time"

	"github.com/gofabrik/fabrik/templates"
)

//fabrik:provider
func NewServer(cfg *Config) *http.Server {
	return &http.Server{
		Addr:              cfg.Addr,
		ReadHeaderTimeout: 5 * time.Second,
	}
}

type ErrorPage struct {
	Method string
	Path   string
}

// ErrorPages renders the router's miss responses through the app's
// template set with shared layout data. Body-only handlers keep the
// router's status codes.
type ErrorPages struct {
	Templates *templates.Set
}

func (e *ErrorPages) data(r *http.Request, page any) *WebData {
	return &WebData{
		Page:    page,
		Request: RequestView{Path: r.URL.Path, Route: r.Pattern},
	}
}

//fabrik:http:notfound
func (e *ErrorPages) NotFound(w http.ResponseWriter, r *http.Request) {
	var page bytes.Buffer
	if err := e.Templates.Render(&page, "errors/404", e.data(r, ErrorPage{Path: r.URL.Path})); err != nil {
		http.NotFound(w, r)
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	page.WriteTo(w)
}

//fabrik:http:methodnotallowed
func (e *ErrorPages) MethodNotAllowed(w http.ResponseWriter, r *http.Request) {
	d := e.data(r, ErrorPage{Method: r.Method, Path: r.URL.Path})
	var page bytes.Buffer
	if err := e.Templates.Render(&page, "errors/405", d); err != nil {
		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	page.WriteTo(w)
}
